# Builder brain (ADR-0001, named "composer" there — renamed to Builder).
# Provider keys here unlock the per-Session Builder-model picker (anthropic
# and/or openai); at least one is required. BUILDER_PROVIDER/BUILDER_MODEL are
# the default when a Session picks none (legacy COMPOSER_* still honored).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BUILDER_PROVIDER=anthropic
BUILDER_MODEL=claude-sonnet-4-6

# TurnCall integration (single-tenant, ADR-0002) — used by the create + events tasks
TURNCALL_API_KEY=
# Self-hosting? This is your own TurnCall instance. docker-compose already
# defaults it to http://host.docker.internal:8090; only set it here to override.
# TURNCALL_BASE_URL=http://host.docker.internal:8090
# Platform credential the builder presents (X-Platform-Key) to provision TurnCall
# projects/keys — must match TurnCall's PLATFORM_API_KEY once it's gated (turncall#102).
PLATFORM_API_KEY=
PUBLIC_BASE_URL=
# TurnCall's public (Twilio-reachable) URL — shown in the console as the voice
# webhook to verify/paste; should match TurnCall's own PUBLIC_BASE_URL.
TURNCALL_PUBLIC_URL=

# Postgres (next task)
DATABASE_URL=

# --- GitHub integration (adr/0013) ---
# Encrypts users' GitHub tokens at rest. Without it, GitHub connections are
# disabled — the API refuses to store a token rather than storing it in the
# clear. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it once and leave it: rotating invalidates every stored token and every
# user has to reconnect.
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Integrations / Pipedream Connect (docs/adr/0018) ---
# Pipedream holds the Workspace's Slack and Google credentials; the builder holds
# only these, and only encrypted at rest. From pipedream.com > Connect > your
# project. Without PIPEDREAM_CLIENT_SECRET the integration endpoints 503 and say
# so — nothing half-works.
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
# Where Pipedream sends the admin back: this API's own public callback URL, e.g.
# https://builder-api.example.com/integrations/callback. Not PUBLIC_BASE_URL —
# that is the console, and the callback has to reach the API.
PIPEDREAM_REDIRECT_URI=
# development is free; production is $99/mo plus credits (ADR-0018).
PIPEDREAM_ENVIRONMENT=development
# Encrypts the client secret at rest. Same generator as the GitHub key above:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the stored secret unreadable — the API says so loudly, and a
# restart re-stores it from PIPEDREAM_CLIENT_SECRET.
PIPEDREAM_ENCRYPTION_KEY=

# Provider Integrations + Workspace MCP servers (ADR-0023): a Workspace's own
# provider keys and registered MCP headers are Fernet-encrypted with this. Same
# generator as above; its own key, never shared. Set once — changing it makes
# every stored Integration unreadable and each Workspace must reconnect.
# TurnCall needs CREDENTIAL_ENCRYPTION_KEY set too, for the projected copies.
INTEGRATIONS_ENCRYPTION_KEY=

# The clock generated agents reason in. call-init tells each call today's date
# in this zone, because an LLM has no clock and will otherwise invent one.
# An IANA name, e.g. Asia/Jerusalem. Wrong or missing falls back to UTC.
AGENT_TIMEZONE=UTC
