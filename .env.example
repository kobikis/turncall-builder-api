# Builder brain (ADR-0001, named "composer" there — renamed to Builder).
# Provider keys here unlock the per-Session Builder-model picker (anthropic
# and/or openai); at least one is required. BUILDER_PROVIDER/BUILDER_MODEL are
# the default when a Session picks none (legacy COMPOSER_* still honored).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BUILDER_PROVIDER=anthropic
BUILDER_MODEL=claude-sonnet-4-6

# TurnCall integration (single-tenant, ADR-0002) — used by the create + events tasks
TURNCALL_API_KEY=
# Self-hosting? This is your own TurnCall instance. docker-compose already
# defaults it to http://host.docker.internal:8090; only set it here to override.
# TURNCALL_BASE_URL=http://host.docker.internal:8090
# Platform credential the builder presents (X-Platform-Key) to provision TurnCall
# projects/keys — must match TurnCall's PLATFORM_API_KEY once it's gated (turncall#102).
PLATFORM_API_KEY=
PUBLIC_BASE_URL=
# TurnCall's public (Twilio-reachable) URL — shown in the console as the voice
# webhook to verify/paste; should match TurnCall's own PUBLIC_BASE_URL.
TURNCALL_PUBLIC_URL=

# Postgres (next task)
DATABASE_URL=

# --- GitHub integration (adr/0013) ---
# Encrypts users' GitHub tokens at rest. Without it, GitHub connections are
# disabled — the API refuses to store a token rather than storing it in the
# clear. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it once and leave it: rotating invalidates every stored token and every
# user has to reconnect.
GITHUB_TOKEN_ENCRYPTION_KEY=
